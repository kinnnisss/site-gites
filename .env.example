# Development project only. These are fictitious placeholders, never production.
NEXT_PUBLIC_SUPABASE_URL=https://development-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_replace_with_development_key

# Server-side trusted origin. Required only to enable password-recovery requests.
TEAM_APP_ORIGIN=http://localhost:3000

# No service_role, secret Supabase key, SMTP password or database password is needed.
# Behind Codex Cloud's injected proxy, start with NODE_USE_ENV_PROXY=1 (tested on Node 22.23.4).
